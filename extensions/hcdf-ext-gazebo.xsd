<?xml version="1.0" encoding="UTF-8"?>
<!--
  HCDF Gazebo Extension Schema
  Version: 1.0

  Defines the structure of content inside <extension domain="org.gazebosim">.
  Provides physics engine configuration and simulation plugin declarations
  for Gazebo (gz-sim) integration.

  Example usage within an HCDF file:

    <extension domain="org.gazebosim" version="1.0">
      <physics>
        <engine>ode</engine>
        <max-step-size>0.001</max-step-size>
        <real-time-factor>1.0</real-time-factor>
      </physics>
      <plugin name="aerodynamics" filename="libAerodynamicsPlugin.so">
        <link>frame</link>
        <air-density>1.225</air-density>
      </plugin>
    </extension>
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           version="1.0"
           elementFormDefault="unqualified">

  <!-- ================================================================== -->
  <!-- Physics engine enumeration                                         -->
  <!-- ================================================================== -->
  <xs:simpleType name="PhysicsEngine">
    <xs:annotation>
      <xs:documentation>Supported physics engine backends in Gazebo.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="ode">
        <xs:annotation>
          <xs:documentation>Open Dynamics Engine, the default physics engine in Gazebo classic and gz-sim.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="bullet">
        <xs:annotation>
          <xs:documentation>Bullet Physics, real-time collision detection and multi-physics simulation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="dart">
        <xs:annotation>
          <xs:documentation>Dynamic Animation and Robotics Toolkit, multi-body dynamics for robotics and animation.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="simbody">
        <xs:annotation>
          <xs:documentation>Simbody, multibody physics engine optimized for biomechanics and robotics.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="tpe">
        <xs:annotation>
          <xs:documentation>Trivial Physics Engine, lightweight engine for basic kinematic simulation without dynamics.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>

  <!-- ================================================================== -->
  <!-- Physics configuration type                                         -->
  <!-- ================================================================== -->
  <xs:complexType name="physics">
    <xs:annotation>
      <xs:documentation>Physics engine configuration for the Gazebo simulation.
Controls which dynamics solver is used, simulation time step, and
the ratio of simulation time to wall-clock time.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="engine" type="PhysicsEngine" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Physics engine backend to use (ode, bullet, dart, simbody, tpe).
Defaults to "ode" if not specified.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="max-step-size" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Maximum physics time step in seconds (e.g., 0.001 for 1 ms).
Smaller values increase accuracy but reduce simulation speed.
Typical range: 0.0001 to 0.01.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="real-time-factor" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Target ratio of simulation time to wall-clock time.
1.0 means real-time, 0.5 means half-speed, 2.0 means double-speed.
Set to 0 for maximum speed (no throttling).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Plugin type: a Gazebo simulation plugin                            -->
  <!-- ================================================================== -->
  <xs:complexType name="plugin">
    <xs:annotation>
      <xs:documentation>A Gazebo simulation plugin declaration. Plugins extend simulation
behavior: physics models, sensor simulation, controllers, etc.
Child elements are plugin-specific parameters passed through with
lax validation (any well-formed XML is accepted).</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="lax">
        <xs:annotation>
          <xs:documentation>Plugin-specific parameters. The content depends on the plugin
implementation; any well-formed XML elements are accepted.
Examples: &lt;link&gt;, &lt;air-density&gt;, &lt;turning-direction&gt;, etc.</xs:documentation>
        </xs:annotation>
      </xs:any>
    </xs:sequence>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Unique name identifying this plugin instance within the model
(e.g., "aerodynamics", "motor_model", "contact_sensor").</xs:documentation>
      </xs:annotation>
    </xs:attribute>
    <xs:attribute name="filename" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Shared library filename for the plugin
(e.g., "libAerodynamicsPlugin.so", "libMotorModelPlugin.so").
Gazebo searches its plugin path for this library at load time.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Velocity decay (per-link damping)                                  -->
  <!-- ================================================================== -->
  <xs:complexType name="velocity-decay">
    <xs:annotation>
      <xs:documentation>Per-link velocity damping applied every step (SDF link/velocity_decay).
Linear and angular decay factors reduce a link's velocity to model drag or
numerical stabilization.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="linear" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Linear velocity decay factor (SDF velocity_decay/linear).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="angular" type="xs:double" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Angular velocity decay factor (SDF velocity_decay/angular).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Model-scope simulation scalars                                     -->
  <!-- ================================================================== -->
  <xs:complexType name="model-physics">
    <xs:annotation>
      <xs:documentation>Model-scope Gazebo simulation flags that have no home in the clean
cyber-physical core but must round-trip through the gazebo extension
(SDF model/static, self_collide, allow_auto_disable, enable_wind,
canonical_link). All optional.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="static" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Model is immovable (SDF model/static).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="self-collide" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Links within the model collide with each other (SDF model/self_collide).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="allow-auto-disable" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Allow the physics engine to auto-disable the model when at rest
(SDF model/allow_auto_disable).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="enable-wind" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Model is affected by wind (SDF model/enable_wind).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="canonical-link" type="xs:string" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Name of the model's canonical link: the implicit model-frame anchor
(SDF model/@canonical_link).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Link-scope simulation scalars                                      -->
  <!-- ================================================================== -->
  <xs:complexType name="link-physics">
    <xs:annotation>
      <xs:documentation>Per-link Gazebo simulation flags with no cyber-physical-core home,
round-tripped through the gazebo extension (SDF link/gravity,
self_collide, kinematic, must_be_base_link, velocity_decay). Keyed by
link (comp) name. All optional.</xs:documentation>
    </xs:annotation>
    <xs:all>
      <xs:element name="gravity" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Link is affected by gravity (SDF link/gravity).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="self-collide" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Link collides with other links of the same model (SDF link/self_collide).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="kinematic" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Link is kinematic: pose-driven, not force-driven (SDF link/kinematic).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="must-be-base-link" type="xs:boolean" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Link must be the model's base link (SDF link/must_be_base_link).</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="velocity-decay" type="velocity-decay" minOccurs="0">
        <xs:annotation>
          <xs:documentation>Per-link linear/angular velocity damping (SDF link/velocity_decay).</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation>
        <xs:documentation>Name of the link (HCDF comp) these flags apply to.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <!-- ================================================================== -->
  <!-- Root element: gazebo-sim                                           -->
  <!-- ================================================================== -->
  <xs:element name="gazebo-sim">
    <xs:annotation>
      <xs:documentation>Root element of the Gazebo extension. Contains physics engine
configuration and plugin declarations for gz-sim integration.
Placed inside &lt;extension domain="org.gazebosim"&gt;.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="physics" type="physics" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Physics engine configuration. At most one per extension block.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="plugin" type="plugin" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Simulation plugin declaration. Zero or more plugins can be defined,
each with its own name, library filename, and plugin-specific parameters.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="model-physics" type="model-physics" minOccurs="0">
          <xs:annotation>
            <xs:documentation>Model-scope simulation flags (static, self_collide, allow_auto_disable,
enable_wind, canonical_link) round-tripped through the gazebo extension. At most one.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="link-physics" type="link-physics" minOccurs="0" maxOccurs="unbounded">
          <xs:annotation>
            <xs:documentation>Per-link simulation flags (gravity, self_collide, kinematic,
must_be_base_link, velocity_decay), one entry per link, round-tripped through the extension.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>

</xs:schema>
