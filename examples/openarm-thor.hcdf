  <!-- Left wrist RealSense (USB3 device end on the Thor's usb1) -->
  <comp name="l_realsense" role="sensor">
    <description>Left wrist Intel RealSense D435 depth camera (USB 3.1 gen1 device)</description>
    <board>intel-realsense-d435</board>
    <collision name="cam_box"><geometry><box><size>0.09 0.025 0.025</size></box></geometry></collision>
    <port name="usb">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <rate min="5000000000" max="5000000000" nominal="5000000000" unit="bit/s"/>
      </capabilities>
    </port>
    <connector name="usb_connector" family="legacy:usb-c"/>
    <sensor name="wrist_cam" update-rate="30">
      <optical type="camera">
        <driver name="realsense-d435"/>
        <geometry><box><size>0.09 0.025 0.025</size></box></geometry>
        <fov name="rgb">
          <geometry>
            <frustum shape="pyramidal">
              <near>0.1</near>
              <far>10.0</far>
              <hfov>1.211</hfov>
              <vfov>0.742</vfov>
            </frustum>
          </geometry>
          <intrinsics>
            <width>1920</width>
            <height>1080</height>
            <format>RGB8</format>
            <fx>1380.0</fx>
            <fy>1380.0</fy>
