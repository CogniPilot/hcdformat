<?xml version="1.0"?>
<!--
  OpenArm + Jetson Thor: the bimanual teleop target system.

  An NVIDIA Jetson AGX Thor drives two 7-DOF OpenArm manipulators. Each arm is a chain of
  seven Damiao-class CAN-FD motor drives on its OWN CAN-FD bus (right arm on the Thor's can0,
  left arm on can1) plus a wrist-mounted Intel RealSense depth camera on USB3. The two arms
  and the Thor share one 48 V power rail from the battery/PSU.

  This example is about NETWORK fidelity, not mechanism: the comp geometry is deliberately
  simplified to boxes/cylinders and there is no kinematic joint tree (like cps-comms-showcase,
  the point is the buses and links). The two CAN-FD buses carry the interesting detail: split
  1 Mbit arbitration / 5 Mbit data phase, 120r-split termination at exactly the two physical
  ends, an FD transceiver, and per-drive node IDs 1..7 in physical position order. No FSoE /
  functional-safety channel is modeled: this hardware has no black-channel safety layer, so
  adding one would misrepresent this hardware rather than model it faithfully.
-->
<hcdf version="1.0" name="openarm-thor">

  <!-- ===== Compute: NVIDIA Jetson AGX Thor ===== -->
  <comp name="jetson_thor" role="compute">
    <description>NVIDIA Jetson AGX Thor, the dual-arm host: 2x CAN-FD (one bus per arm), 2x USB3 (one RealSense per arm), a 25G-class uplink, and an onboard regulator off the 48 V rail</description>
    <board>nvidia-agx-thor</board>
    <collision name="thor_box">
      <geometry><box><size>0.11 0.11 0.07</size></box></geometry>
    </collision>
    <!-- Ports laid out as a connector row across the +X face (box is 0.11 wide), so the glyphs
         read as a real I/O panel and don't stack at the component origin. -->
    <port name="can0">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:can"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="bps"/>
      </capabilities>
    </port>
    <port name="can1">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:can"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="bps"/>
      </capabilities>
    </port>
    <port name="usb0">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <rate min="5000000000" max="5000000000" nominal="5000000000" unit="bit/s"/>
      </capabilities>
    </port>
    <port name="usb1">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <rate min="5000000000" max="5000000000" nominal="5000000000" unit="bit/s"/>
      </capabilities>
    </port>
    <port name="uplink">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <rate min="10000000000" max="10000000000" nominal="10000000000" unit="bit/s"/>
      </capabilities>
    </port>
    <port name="pwr_in">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="40" max="58" nominal="48" unit="V"/>
        <current max="6" nominal="3" unit="A"/>
      </capabilities>
    </port>
    <connector name="can0_connector" family="legacy:jst-gh">
      <representation><sphere radius="0.005"><placement xyz="0.056 -0.045 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <connector name="can1_connector" family="legacy:jst-gh">
      <representation><sphere radius="0.005"><placement xyz="0.056 -0.027 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <connector name="usb0_connector" family="legacy:usb-c">
      <representation><sphere radius="0.005"><placement xyz="0.056 -0.009 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <connector name="usb1_connector" family="legacy:usb-c">
      <representation><sphere radius="0.005"><placement xyz="0.056 0.009 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <connector name="uplink_connector" family="legacy:m12-x">
      <representation><sphere radius="0.005"><placement xyz="0.056 0.027 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <connector name="pwr_in_connector" family="legacy:xt30">
      <representation><sphere radius="0.005"><placement xyz="0.056 0.045 0"><frame><component-origin component="jetson_thor"/></frame><rotation><rpy value="0 0 0"/></rotation></placement></sphere></representation>
    </connector>
    <termination name="can0_termination" kind="hcdf:resistor" mounting="endpoint" fidelity="presented" profile="hcdf:can">
      <attachment><connector-ref connector="can0_connector"><component-ref component="jetson_thor"/></connector-ref></attachment>
      <quantity property="hcdf:resistance" value="120" unit="ohm"/>
    </termination>
    <termination name="can1_termination" kind="hcdf:resistor" mounting="endpoint" fidelity="presented" profile="hcdf:can">
      <attachment><connector-ref connector="can1_connector"><component-ref component="jetson_thor"/></connector-ref></attachment>
      <quantity property="hcdf:resistance" value="120" unit="ohm"/>
    </termination>
  </comp>

  <!-- ===== Right arm: 7 Damiao CAN-FD drives (node IDs 1..7) ===== -->
  <comp name="r_drive_1" role="actuator">
    <description>Right arm J1: Damiao DM-J8009 CAN-FD drive (shoulder)</description>
    <board>damiao-dm-j8009</board>
    <collision name="j_col"><geometry><cylinder><radius>0.045</radius><length>0.06</length></cylinder></geometry></collision>
    <port name="can">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:can"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="bps"/>
      </capabilities>
    </port>
    <port name="vin">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="40" max="58" nominal="48" unit="V"/>
      </capabilities>
    </port>
    <connector name="can_connector" family="legacy:jst-gh"/>
  </comp>
  <comp name="r_drive_2" role="actuator">
    <description>Right arm J2: Damiao DM-J8009 CAN-FD drive (shoulder)</description>
    <board>damiao-dm-j8009</board>
