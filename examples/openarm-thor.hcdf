    </port>
    <connector name="can_connector" family="legacy:jst-gh"/>
  </comp>
  <comp name="r_drive_7" role="actuator">
    <description>Right arm J7: Damiao DM-J4310 CAN-FD drive (wrist roll; physical bus end)</description>
    <board>damiao-dm-j4310</board>
    <collision name="j_col"><geometry><cylinder><radius>0.03</radius><length>0.045</length></cylinder></geometry></collision>
