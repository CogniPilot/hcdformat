  <comp name="r_drive_6" role="actuator">
    <description>Right arm J6: Damiao DM-J4310 CAN-FD drive (wrist)</description>
    <board>damiao-dm-j4310</board>
    <collision name="j_col"><geometry><cylinder><radius>0.03</radius><length>0.045</length></cylinder></geometry></collision>
