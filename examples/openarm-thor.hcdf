  <!-- ===== Battery / PSU: the shared 48 V rail source ===== -->
  <comp name="power_dist" role="parent">
    <description>Battery + power-distribution board: the single 48 V rail feeding the Thor and both arms</description>
    <collision name="psu_box"><geometry><box><size>0.16 0.12 0.08</size></box></geometry></collision>
    <port name="vout">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="40" max="58" nominal="48" unit="V"/>
        <current max="40" nominal="30" unit="A"/>
        <power max="2000" nominal="1440" unit="W"/>
      </capabilities>
    </port>
    <connector name="vout_connector" family="legacy:xt60"/>
    <power-source name="main_battery">
      <battery>
        <chemistry>Li-ion</chemistry>
        <cells-series>13</cells-series>
        <nominal-voltage unit="V">48</nominal-voltage>
        <capacity unit="Ah">10</capacity>
        <energy unit="Wh">480</energy>
        <min-voltage unit="V">39</min-voltage>
        <max-voltage unit="V">54.6</max-voltage>
      </battery>
    </power-source>
  </comp>

  <!-- ===== Networks ===== -->
  <binding name="jetson_thor_can0_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="can0"/></functional>
    <physical><connector-ref connector="can0_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="jetson_thor_can1_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="can1"/></functional>
    <physical><connector-ref connector="can1_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="jetson_thor_usb0_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="usb0"/></functional>
    <physical><connector-ref connector="usb0_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="jetson_thor_usb1_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="usb1"/></functional>
    <physical><connector-ref connector="usb1_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="jetson_thor_uplink_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="uplink"/></functional>
    <physical><connector-ref connector="uplink_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="jetson_thor_pwr_in_presented" fidelity="presented">
    <functional><port-ref component="jetson_thor" port="pwr_in"/></functional>
    <physical><connector-ref connector="pwr_in_connector"><component-ref component="jetson_thor"/></connector-ref></physical>
  </binding>
  <binding name="r_realsense_usb_presented" fidelity="presented">
    <functional><port-ref component="r_realsense" port="usb"/></functional>
    <physical><connector-ref connector="usb_connector"><component-ref component="r_realsense"/></connector-ref></physical>
  </binding>
  <binding name="l_realsense_usb_presented" fidelity="presented">
    <functional><port-ref component="l_realsense" port="usb"/></functional>
    <physical><connector-ref connector="usb_connector"><component-ref component="l_realsense"/></connector-ref></physical>
  </binding>
