{
  "hcdf": {
    "version": 1.0,
    "name": "tactile-sensor-test",
    "comp": {
      "name": "hand",
      "role": "sensor",
      "sensor": [
        {
          "name": "fingertip_touch",
          "tactile": {
            "type": "capacitive",
            "driver": {
              "name": "takktile-v2"
            },
            "rows": 4,
            "cols": 4,
            "taxels": 16,
            "spatial-resolution": {
              "unit": "mm",
              "$text": 2.5
            },
            "pressure-range": {
              "min": 0.1,
              "max": 100,
              "unit": "kPa"
            },
            "sensing-area": {
              "unit": "mm2",
              "$text": 100
            }
          }
        },
        {
          "name": "palm_skin",
          "tactile": [
            {
              "type": "barometric",
              "driver": {
                "name": "xela-uskin-16"
              },
              "taxels": 16,
              "spatial-resolution": {
                "unit": "mm",
                "$text": 7
              },
              "pressure-range": {
                "min": 0.5,
                "max": 200,
                "unit": "kPa"
              },
              "sensing-area": {
                "unit": "cm2",
                "$text": 12
              }
            },
            {
              "type": "optical",
              "driver": {
                "name": "gelsight-mini"
              },
              "range": {
                "unit": "mm",
                "$text": 5
              },
              "resolution": {
                "unit": "um",
                "$text": 25
              },
              "sensing-area": {
                "unit": "mm2",
                "$text": 314
              }
            }
          ]
        }
      ]
    }
  }
}
