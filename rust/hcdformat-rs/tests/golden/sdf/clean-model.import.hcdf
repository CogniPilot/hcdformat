<hcdf name="clean-bot" body-frame="FLU" world-frame="ENU">
  <comp name="base">
    <inertial>
      <mass>2.0</mass>
      <inertia_origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia>0.1 0 0 0.1 0 0.1</inertia>
    </inertial>
    <visual name="base_visual">
      <pose xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box>
          <size>0.3 0.3 0.1</size>
        </box>
      </geometry>
      <color rgba="0.8 0.2 0.2 1"/>
    </visual>
    <collision name="base_collision">
      <pose xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box>
          <size>0.3 0.3 0.1</size>
        </box>
      </geometry>
      <surface>
        <friction static="0.8">
          <friction-direction mu2="0.6"/>
        </friction>
        <restitution>0.2</restitution>
      </surface>
    </collision>
  </comp>
  <comp name="link1">
    <inertial>
      <mass>0.5</mass>
      <inertia>0.01 0 0 0.01 0 0.01</inertia>
    </inertial>
    <visual name="link1_visual">
      <geometry>
        <cylinder>
          <radius>0.05</radius>
          <length>0.4</length>
        </cylinder>
      </geometry>
    </visual>
  </comp>
  <joint name="joint1" type="revolute">
    <parent comp="base"/>
    <child comp="link1"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="2"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
</hcdf>