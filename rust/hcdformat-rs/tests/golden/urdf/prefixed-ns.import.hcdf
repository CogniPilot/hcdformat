<hcdf name="prefixed_ns" body-frame="FLU" world-frame="ENU">
  <comp name="base"/>
  <comp name="arm"/>
  <joint name="j" type="revolute">
    <parent comp="base"/>
    <child comp="arm"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="10" velocity="2"/>
  </joint>
  <extension domain="urdf:gazebo_ros_controller_manager"><controller:gazebo_ros_controller_manager name="cm" xmlns:controller="http://ros.org/controller">
    <controller:rate>100</controller:rate>
  </controller:gazebo_ros_controller_manager></extension>
</hcdf>