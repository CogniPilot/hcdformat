<?xml version="1.0" encoding="UTF-8"?>
<robot name="synth-arm"><material name="grey"><color rgba="0.6 0.6 0.6 1"/></material><link name="base"></link><link name="arm"><inertial><mass value="1.2"/><origin xyz="0 0 0.1" rpy="0 0 0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.005"/></inertial><visual><geometry><cylinder radius="0.03" length="0.2"/></geometry><material name="grey"/></visual><collision><geometry><box size="0.05 0.05 0.2"/></geometry></collision></link><link name="tool"><visual><origin xyz="0 0 0.2"/><geometry><mesh filename="package://x/tool.dae"/></geometry></visual><collision><geometry><mesh filename="package://x/tool_collision.stl"/></geometry></collision></link><link name="finger_l"></link><link name="finger_r"></link><joint name="j1" type="revolute"><parent link="base"/><child link="arm"/><axis xyz="0 0 1"/><limit lower="-1.5" upper="1.5" effort="10" velocity="2"/><dynamics damping="0.1" friction="0.05"/><calibration rising="0.0"/><safety_controller soft_lower_limit="-1.4" soft_upper_limit="1.4" k_position="10" k_velocity="1"/></joint><joint name="j2" type="continuous"><parent link="arm"/><child link="tool"/><origin xyz="0 0 0.2"/><axis xyz="1 0 0"/></joint><joint name="j3" type="prismatic"><parent link="tool"/><child link="finger_l"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="40" velocity="0.1"/></joint><joint name="j4" type="prismatic"><parent link="tool"/><child link="finger_r"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="40" velocity="0.1"/><mimic joint="j3" multiplier="-1" offset="0"/></joint><gazebo reference="arm"><mu1>0.8</mu1><mu2>0.8</mu2></gazebo><ros2_control name="ctl" type="system"><joint name="j1"/></ros2_control></robot>