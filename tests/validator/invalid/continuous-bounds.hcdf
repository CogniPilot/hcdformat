  <comp name="a"/>
  <comp name="b"/>
  <joint name="j" type="continuous">
    <parent comp="a"/>
    <child comp="b"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1"/>
  </joint>
</hcdf>
