<?xml version="1.0"?>
<!-- validator-invalid: ball (3-DOF spherical) carries an <axis> (E_JOINT_AXIS_FORBIDDEN) -->
<hcdf version="1.0" name="ball-with-axis">
  <comp name="a"/>
  <comp name="b"/>
  <joint name="j" type="ball">
    <parent comp="a"/>
    <child comp="b"/>
    <axis xyz="0 0 1"/>
  </joint>
</hcdf>
