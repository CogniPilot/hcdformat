  <!-- Waveshare bus-servo adapter: USB device to the host + single-wire TTL to the chain +
       the 7.4 V rail source it fans out to the servos. -->
  <comp name="waveshare" role="compute">
    <description>Waveshare Serial Bus Servo Driver (USB &lt;-&gt; half-duplex TTL)</description>
    <inertial>
      <mass>0.02</mass>
      <inertia_origin xyz="0 0 0"/>
      <inertia>2.0e-6 0 0 2.0e-6 0 2.0e-6</inertia>
    </inertial>
    <port name="usb">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <rate min="480000000" max="480000000" nominal="480000000" unit="bit/s"/>
      </capabilities>
    </port>
    <port name="ttl">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:uart"/>
        <profile id="feetech:sts"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="Bd"/>
      </capabilities>
    </port>
    <port name="vpwr">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="6" max="12.6" nominal="7.4" unit="V"/>
        <current min="0" max="10" nominal="6" unit="A"/>
      </capabilities>
    </port>
    <connector name="usb_connector" family="usb:type-c"/>
    <connector name="servo_connector" family="molex:5264-3p">
      <pin name="GND"/>
      <pin name="V+"/>
      <pin name="Signal"/>
    </connector>
    <connector name="power_connector" family="hcdf:dc-barrel-5.5x2.1"/>
  </comp>
  <!-- 6-DOF serial chain: base -> pan -> lift -> elbow -> wrist_flex -> wrist_roll -> gripper -->
  <joint name="shoulder_pan" type="revolute">
    <parent comp="base"/>
    <child comp="servo_1"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.92" upper="1.92" effort="3.0" velocity="6.0"/>
  </joint>
  <joint name="shoulder_lift" type="revolute">
    <parent comp="servo_1"/>
    <child comp="servo_2"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.75" upper="1.75" effort="3.0" velocity="6.0"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent comp="servo_2"/>
    <child comp="servo_3"/>
    <origin xyz="0 0 0.11" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.69" upper="1.69" effort="3.0" velocity="6.0"/>
  </joint>
  <joint name="wrist_flex" type="revolute">
    <parent comp="servo_3"/>
    <child comp="servo_4"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.66" upper="1.66" effort="2.0" velocity="6.0"/>
  </joint>
  <joint name="wrist_roll" type="revolute">
    <parent comp="servo_4"/>
    <child comp="servo_5"/>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2.79" upper="2.79" effort="2.0" velocity="6.0"/>
  </joint>
  <joint name="gripper" type="revolute">
    <parent comp="servo_5"/>
    <child comp="servo_6"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.17" upper="1.75" effort="2.0" velocity="6.0"/>
  </joint>
  <joint name="adapter_mount" type="fixed">
    <parent comp="base"/>
    <child comp="waveshare"/>
    <origin xyz="-0.05 0 0.01" rpy="0 0 0"/>
  </joint>
