<!--
  SO-ARM101 follower: the STS servo bus, the first example to model Feetech STS3215 serial servos.

  The SO-101 follower is a 6-DOF Feetech STS3215 arm driven from a Waveshare bus-servo
  adapter. The adapter is a USB-serial converter: a USB device port faces the host PC and a
  single-wire TTL port drives the servo chain. The six STS3215 servos are physically
  daisy-chained through their two pass-through Molex 5264-3P connectors, but ELECTRICALLY
  they form one multidrop half-duplex TTL bus (STS framing, 8N1, 1 Mbaud, IDs 1-6).
  The 5264 connector carries GND, V+, and Signal, so the 7.4 V servo rail remains a separate
  power-delivery bus from the 5 V TTL communication bus.
--><hcdf name="so-arm101-buses" version="1.0">
  <!-- Base + the 6 STS3215 follower joints -->
  <comp name="base" role="parent">
    <description>SO-101 follower base</description>
    <inertial>
      <mass>0.4</mass>
      <inertia_origin xyz="0 0 0.02"/>
      <inertia>3.0e-4 0 0 3.0e-4 0 5.0e-4</inertia>
    </inertial>
    <collision name="base_col">
      <geometry>
        <box>
          <size>0.09 0.09 0.04</size>
        </box>
      </geometry>
    </collision>
  </comp>
  <comp name="servo_1" role="actuator">
    <description>STS3215 #1: shoulder pan</description>
    <inertial>
      <mass>0.06</mass>
      <inertia_origin xyz="0 0 0"/>
      <inertia>1.0e-5 0 0 1.0e-5 0 1.0e-5</inertia>
    </inertial>
    <port name="sts">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:uart"/>
        <profile id="feetech:sts"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="Bd"/>
      </capabilities>
    </port>
    <port name="vin">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="6" max="12.6" nominal="7.4" unit="V"/>
        <current min="0" max="2.7" nominal="0.5" unit="A"/>
      </capabilities>
    </port>
    <connector name="upstream" family="molex:5264-3p">
      <pin name="GND"/>
      <pin name="V+"/>
      <pin name="Signal"/>
    </connector>
    <connector name="downstream" family="molex:5264-3p">
      <pin name="GND"/>
      <pin name="V+"/>
      <pin name="Signal"/>
    </connector>
  </comp>
  <comp name="servo_2" role="actuator">
    <description>STS3215 #2: shoulder lift</description>
    <inertial>
      <mass>0.06</mass>
      <inertia_origin xyz="0 0 0"/>
      <inertia>1.0e-5 0 0 1.0e-5 0 1.0e-5</inertia>
    </inertial>
    <port name="sts">
      <capabilities>
        <purpose value="communication"/>
        <carrier value="electrical"/>
        <profile id="hcdf:uart"/>
        <profile id="feetech:sts"/>
        <rate min="1000000" max="1000000" nominal="1000000" unit="Bd"/>
      </capabilities>
    </port>
    <port name="vin">
      <capabilities>
        <purpose value="power-delivery"/>
        <carrier value="electrical"/>
        <voltage min="6" max="12.6" nominal="7.4" unit="V"/>
      </capabilities>
    </port>
    <connector name="upstream" family="molex:5264-3p">
      <pin name="GND"/>
      <pin name="V+"/>
      <pin name="Signal"/>
    </connector>
    <connector name="downstream" family="molex:5264-3p">
      <pin name="GND"/>
