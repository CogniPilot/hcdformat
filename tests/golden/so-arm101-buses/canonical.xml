  <!-- The STS servo bus and its separate 7.4 V power rail. -->
  <bus name="sts_bus">
    <description>Feetech STS3215 half-duplex single-wire TTL bus using STS framing at 1 Mbaud, with servo IDs 1 through 6.</description>
    <selected purpose="communication" carrier="electrical">
      <profile id="hcdf:uart"/>
      <profile id="feetech:sts"/>
      <rate>
        <nominal value="1000000" unit="Bd"/>
      </rate>
    </selected>
    <participant name="waveshare" role="hcdf:controller">
      <endpoint>
        <port-ref component="waveshare" port="ttl"/>
      </endpoint>
    </participant>
    <participant name="servo_1" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_1" port="sts"/>
      </endpoint>
    </participant>
    <participant name="servo_2" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_2" port="sts"/>
      </endpoint>
    </participant>
    <participant name="servo_3" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_3" port="sts"/>
      </endpoint>
    </participant>
    <participant name="servo_4" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_4" port="sts"/>
      </endpoint>
    </participant>
    <participant name="servo_5" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_5" port="sts"/>
      </endpoint>
    </participant>
    <participant name="servo_6" role="hcdf:target">
      <endpoint>
        <port-ref component="servo_6" port="sts"/>
      </endpoint>
    </participant>
  </bus>
  <bus name="servo_power">
    <description>7.4 V rail carried on the 5264 connectors, separate from the 5 V TTL signaling on sts_bus.</description>
    <selected purpose="power-delivery" carrier="electrical">
      <voltage>
        <nominal value="7.4" unit="V"/>
      </voltage>
    </selected>
    <participant name="waveshare" role="hcdf:source">
      <endpoint>
        <port-ref component="waveshare" port="vpwr"/>
      </endpoint>
    </participant>
    <participant name="servo_1" role="hcdf:sink">
      <endpoint>
        <port-ref component="servo_1" port="vin"/>
      </endpoint>
    </participant>
    <participant name="servo_2" role="hcdf:sink">
      <endpoint>
        <port-ref component="servo_2" port="vin"/>
      </endpoint>
    </participant>
    <participant name="servo_3" role="hcdf:sink">
      <endpoint>
        <port-ref component="servo_3" port="vin"/>
      </endpoint>
    </participant>
    <participant name="servo_4" role="hcdf:sink">
      <endpoint>
        <port-ref component="servo_4" port="vin"/>
      </endpoint>
