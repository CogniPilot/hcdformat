<robot name="fourbar-loop"><link name="ground"></link><link name="crank"></link><link name="coupler"></link><link name="rocker"></link><joint name="j_crank" type="revolute"><parent link="ground"/><child link="crank"/><axis xyz="0 0 1"/><limit lower="-3.14159" upper="3.14159" effort="20" velocity="3"/></joint><joint name="j_coupler" type="revolute"><parent link="crank"/><child link="coupler"/><origin xyz="0.1 0 0"/><axis xyz="0 0 1"/><limit lower="-2.6" upper="2.6" effort="0" velocity="0"/></joint><joint name="j_rocker" type="revolute"><parent link="ground"/><child link="rocker"/><origin xyz="0.3 0 0"/><axis xyz="0 0 1"/><limit lower="-2.6" upper="2.6" effort="0" velocity="0"/></joint></robot>