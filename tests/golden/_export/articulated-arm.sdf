<sdf version="1.12">
  <model name="articulated-arm">
    <link name="base">
    </link>
    <link name="shoulder">
      <pose relative_to="j1">0 0 0 0 0 0</pose>
    </link>
    <link name="forearm">
      <pose relative_to="j2">0 0 0 0 0 0</pose>
      <visual name="forearm_vis">
        <geometry>
          <cylinder>
            <radius>0.03</radius>
            <length>0.30</length>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.6 0.6 0.65 1.0</diffuse>
        </material>
      </visual>
    </link>
    <link name="wrist">
      <pose relative_to="j_wrist">0 0 0 0 0 0</pose>
    </link>
    <link name="finger_left">
      <pose relative_to="j_finger_l">0 0 0 0 0 0</pose>
    </link>
    <link name="finger_right">
      <pose relative_to="j_finger_r">0 0 0 0 0 0</pose>
    </link>
    <frame name="mount" attached_to="wrist">
    </frame>
    <frame name="tcp" attached_to="mount">
    </frame>
    <frame name="wrt_forearm" attached_to="forearm">
    </frame>
    <frame name="wrt_j2" attached_to="j2">
    </frame>
    <joint name="j1" type="revolute">
      <parent>base</parent>
      <child>shoulder</child>
      <pose relative_to="base">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1.57</lower>
          <upper>1.57</upper>
          <effort>40</effort>
          <velocity>2.0</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="j2" type="revolute">
      <parent>shoulder</parent>
      <child>forearm</child>
      <pose relative_to="shoulder">0 0 0.05 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-2.6</lower>
          <upper>2.6</upper>
          <effort>30</effort>
          <velocity>2.5</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="j_wrist" type="revolute">
      <parent>forearm</parent>
      <child>wrist</child>
      <pose relative_to="forearm">0 0 0.3 0 0 0</pose>
      <axis>
        <xyz>1 0 0</xyz>
      </axis>
    </joint>
    <joint name="j_finger_l" type="prismatic">
      <parent>wrist</parent>
      <child>finger_left</child>
      <pose relative_to="wrist">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.04</upper>
          <effort>60</effort>
          <velocity>0.1</velocity>
        </limit>
      </axis>
    </joint>
    <joint name="j_finger_r" type="prismatic">
      <parent>wrist</parent>
      <child>finger_right</child>
      <pose relative_to="wrist">0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>0</lower>
          <upper>0.04</upper>
          <effort>60</effort>
          <velocity>0.1</velocity>
        </limit>
        <mimic joint="j_finger_l">
          <reference>0</reference>
          <multiplier>-1</multiplier>
        </mimic>
      </axis>
    </joint>
  </model>
</sdf>
