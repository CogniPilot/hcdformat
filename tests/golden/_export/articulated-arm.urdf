<?xml version="1.0" encoding="UTF-8"?>
<robot name="articulated-arm"><material name="anodized"><color rgba="0.6 0.6 0.65 1.0"/></material><link name="base"></link><link name="shoulder"></link><link name="forearm"><visual name="forearm_vis"><geometry><cylinder radius="0.03" length="0.30"/></geometry><material name="anodized"/></visual></link><link name="wrist"></link><link name="finger_left"></link><link name="finger_right"></link><joint name="j1" type="revolute"><parent link="base"/><child link="shoulder"/><axis xyz="0 0 1"/><limit lower="-1.57" upper="1.57" effort="40" velocity="2.0"/></joint><joint name="j2" type="revolute"><parent link="shoulder"/><child link="forearm"/><origin xyz="0 0 0.05"/><axis xyz="0 1 0"/><limit lower="-2.6" upper="2.6" effort="30" velocity="2.5"/></joint><joint name="j_wrist" type="continuous"><parent link="forearm"/><child link="wrist"/><origin xyz="0 0 0.3"/><axis xyz="1 0 0"/></joint><joint name="j_finger_l" type="prismatic"><parent link="wrist"/><child link="finger_left"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="60" velocity="0.1"/></joint><joint name="j_finger_r" type="prismatic"><parent link="wrist"/><child link="finger_right"/><axis xyz="0 1 0"/><limit lower="0" upper="0.04" effort="60" velocity="0.1"/><mimic joint="j_finger_l" multiplier="-1"/></joint></robot>