    <xs:attribute name="soft_upper_limit" type="xs:double"/>
    <xs:attribute name="k_position" type="xs:double"/>
    <xs:attribute name="k_velocity" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:complexType name="urdf_compat_comp">
    <xs:annotation><xs:documentation>Container for URDF-only, zero-CPS fields on a component, kept out of the clean core. Optional; omit for native HCDF authoring.</xs:documentation></xs:annotation>
    <xs:attribute name="link-type" type="xs:string">
      <xs:annotation><xs:documentation>The URDF link/@type (an undocumented PR2-era attribute). Preserved verbatim for URDF round-trip; no HCDF semantics.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="urdf_compat_joint">
    <xs:annotation><xs:documentation>Container for URDF-only, zero-CPS fields on a joint, kept out of the clean core. Optional; omit for native HCDF authoring.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="safety_controller" type="safety_controller" minOccurs="0">
        <xs:annotation><xs:documentation>URDF safety_controller, preserved for round-trip. Only meaningful on joints that map to URDF revolute/prismatic.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="joint_limit">
    <xs:annotation><xs:documentation>Position, velocity, effort, acceleration, and jerk limits for a joint. Required for revolute, prismatic, and cylindrical joints. Units depend on joint type and on which DOF this element bounds: radians/Nm for revolute; meters/N for prismatic; radians for a screw &lt;limit&gt; (the ROTATIONAL DOF; the coupled axial translation is derived via thread_pitch); meters for a cylindrical &lt;limit&gt; (the translation DOF) and radians for its &lt;limit2&gt; (the rotation DOF); radians for universal &lt;limit&gt;/&lt;limit2&gt; (primary axis / axis2); meters for the two planar in-plane ranges (&lt;limit&gt; and &lt;limit2&gt;).</xs:documentation></xs:annotation>
    <xs:attribute name="lower" type="xs:double">
      <xs:annotation><xs:documentation>Lower position limit. Radians for revolute and for a screw &lt;limit&gt; (rotational DOF); meters for prismatic, for a cylindrical &lt;limit&gt; (translation), and for a planar in-plane range. Optional; ABSENCE means unbounded (no schema default is injected); continuous joints MUST omit lower/upper. A 0 resting value must be written explicitly.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="upper" type="xs:double">
      <xs:annotation><xs:documentation>Upper position limit. Radians for revolute and for a screw &lt;limit&gt; (rotational DOF); meters for prismatic, for a cylindrical &lt;limit&gt; (translation), and for a planar in-plane range. Optional; absence means unbounded. Validator rule: upper &gt;= lower for non-continuous joints; continuous joints omit both.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effort" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Maximum joint effort (torque for revolute in Nm, force for prismatic in N). Default: 0 (unlimited if not specified by tooling).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocity" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Maximum joint velocity (rad/s for revolute, m/s for prismatic). Default: 0 (unlimited if not specified by tooling).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="acceleration" type="xs:double">
      <xs:annotation><xs:documentation>Maximum joint acceleration (rad/s^2 for revolute, m/s^2 for prismatic). Optional; used for trajectory planning. Maps to the urdfdom v1.2 limit/@acceleration attribute (mirrors urdfdom_headers JointLimits::acceleration); round-trips on HCDF-&lt;-&gt;URDF conversion.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="jerk" type="xs:double">
      <xs:annotation><xs:documentation>Maximum joint jerk (rad/s^3 for revolute, m/s^3 for prismatic). Optional; used for smooth trajectory generation. Maps to the urdfdom v1.2 limit/@jerk attribute (mirrors urdfdom_headers JointLimits::jerk); round-trips on HCDF-&lt;-&gt;URDF conversion.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="deceleration" type="xs:double">
      <xs:annotation><xs:documentation>Maximum joint deceleration (rad/s^2 for revolute, m/s^2 for prismatic). Optional; distinct from acceleration for asymmetric motion profiles. Maps to the urdfdom v1.2 limit/@deceleration attribute (mirrors urdfdom_headers JointLimits::deceleration); round-trips on HCDF-&lt;-&gt;URDF conversion.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="swing_limit">
    <xs:annotation><xs:documentation>Swing-cone limit for a ball (spherical) joint's two SWING degrees of freedom (the twist DOF is bounded separately by &lt;twist_limit&gt;). Half-angles in radians about the two axes perpendicular to the twist axis (local X). swing1 == swing2 (or swing2 omitted) => a CIRCULAR cone; swing1 != swing2 => an ELLIPTIC cone. This maps 1:1 to Bullet btConeTwistConstraint::setLimit(swing1, swing2, twist), USD UsdPhysicsSphericalJoint (circular/elliptic cone), and MuJoCo's scalar cone (set swing1=swing2, omit twist). Optional; an omitted &lt;swing_limit&gt; means the swing is unbounded (ODE-compatible free ball). Only valid on type="ball".</xs:documentation></xs:annotation>
    <xs:attribute name="swing1" type="xs:double">
      <xs:annotation><xs:documentation>Cone half-angle about local Z, in radians. The maximum swing away from the twist axis in the first perpendicular direction. Required when &lt;swing_limit&gt; is present.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="swing2" type="xs:double">
      <xs:annotation><xs:documentation>Cone half-angle about local Y, in radians. Omit for a circular cone (defaults to swing1); set different from swing1 for an elliptic cone.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="effort" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Maximum swing effort (torque, Nm) resisting motion into the cone limit. Default: 0 (unlimited if not specified by tooling).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="velocity" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Maximum swing angular velocity (rad/s). Default: 0 (unlimited if not specified by tooling).</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="joint_dynamics">
    <xs:annotation><xs:documentation>Joint dynamics parameters for simulation. Defines viscous damping, Coulomb friction, and optional spring behavior.</xs:documentation></xs:annotation>
    <xs:attribute name="damping" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Viscous damping coefficient. Nm/(rad/s) for revolute, N/(m/s) for prismatic. Default: 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="friction" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Coulomb friction torque/force. Nm for revolute, N for prismatic. Applied as constant resistance opposing motion. Default: 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spring_stiffness" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Spring stiffness. Nm/rad for revolute, N/m for prismatic. Creates a restoring force toward spring_reference position. Default: 0 (no spring).</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="spring_reference" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Spring rest position. Radians for revolute, meters for prismatic. The position at which the spring exerts zero force. Default: 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="joint_calibration">
    <xs:annotation><xs:documentation>Joint calibration data for homing and reference position determination. Used to relate encoder readings to absolute joint positions.</xs:documentation></xs:annotation>
    <xs:attribute name="reference_position" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Absolute joint position (radians or meters) corresponding to the calibration reference mark. Default: 0.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="rising" type="xs:double">
      <xs:annotation><xs:documentation>Joint position (radians or meters) at the rising edge of the calibration sensor during a positive-direction sweep.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="falling" type="xs:double">
      <xs:annotation><xs:documentation>Joint position (radians or meters) at the falling edge of the calibration sensor during a positive-direction sweep.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="mimic">
    <xs:annotation><xs:documentation>Mimic joint constraint. Makes this joint's position track another joint's position via a linear relationship: position = multiplier * leader_position + offset. Used for mechanically coupled joints (e.g., parallel gripper fingers, coupled four-bar linkages).</xs:documentation></xs:annotation>
    <xs:attribute name="joint" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Name of the leader joint to mimic. Required. Semantic rule: must reference an existing joint defined in the HCDF document.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="multiplier" type="xs:double" default="1">
      <xs:annotation><xs:documentation>Scaling factor applied to the leader joint's position. Default: 1.0 (identical motion). Use -1 for opposite-direction coupling.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="offset" type="xs:double" default="0">
      <xs:annotation><xs:documentation>Constant offset added after scaling (radians for revolute, meters for prismatic). Default: 0.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

  <xs:complexType name="loop_closure">
    <xs:annotation><xs:documentation>Marks a joint as closing a kinematic loop. Contains the predecessor/successor bodies and which DOFs are constrained at the closure point. Used by dynamics solvers (HyRoDyn, Drake) to handle parallel mechanisms that URDF's tree-only structure cannot represent.</xs:documentation></xs:annotation>
    <xs:sequence>
      <xs:element name="predecessor" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>Predecessor body (comp name) in the kinematic loop at this closure point.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="successor" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>Successor body (comp name) in the kinematic loop at this closure point.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="constraint-axes" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>6-value string "tx ty tz rx ry rz" where 1=constrained, 0=free. Example: "1 1 1 1 1 0" constrains all except rotation around Z.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="joint">
    <xs:annotation><xs:documentation>Kinematic connection between two components defining degrees of freedom. Supports 10 joint types: revolute (bounded rotation), continuous (unbounded rotation), prismatic (linear), fixed (rigid), ball (3-DOF spherical), universal (2-DOF), planar (2D translation), screw (helical), cylindrical (rotation + translation on same axis), and free (6-DOF unconstrained). Semantic rules: revolute/prismatic/cylindrical require axis + limit; fixed and free forbid axis and limit; universal requires axis + axis2; screw requires axis + thread_pitch; planar requires axis (the plane normal); ball forbids axis/axis2/limit/limit2/thread_pitch (its 3-DOF spherical range is a swing-cone + twist expressed by the ball-only swing_limit/twist_limit elements). Per-DOF limit meaning: cylindrical limit = translation (m), limit2 = rotation (rad, optional); universal limit/limit2 = the two axis limits (rad); planar limit/limit2 = the two in-plane translation ranges (m); screw limit = rotational DOF (rad). Stray-field rules: thread_pitch (and its @pitch_convention/@handedness qualifiers) are only valid on screw; axis2 and dynamics2 are only valid on universal; limit2 is only valid on universal, cylindrical, and planar; swing_limit and twist_limit are only valid on ball.</xs:documentation></xs:annotation>
    <xs:all>
      <xs:element name="description" type="xs:string" minOccurs="0">
        <xs:annotation><xs:documentation>Human-readable description of the joint's purpose (e.g., "left shoulder pitch", "front-left wheel spin").</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="parent" type="joint_parent" minOccurs="1">
        <xs:annotation><xs:documentation>Parent component of the joint. Required. The parent remains fixed while the child moves.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="child" type="joint_child" minOccurs="1">
        <xs:annotation><xs:documentation>Child component of the joint. Required. The child moves relative to the parent.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="origin" type="pose" minOccurs="0">
        <xs:annotation><xs:documentation>Pose of the joint frame relative to the parent component's origin. Defines where the joint is located and how it is oriented on the parent body.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="axis" type="axis" minOccurs="0">
        <xs:annotation><xs:documentation>Primary axis of rotation/translation in the joint frame. Required for revolute, continuous, prismatic, cylindrical, universal, screw, and planar joints. For planar joints it is the plane NORMAL (the two DOFs translate in the plane perpendicular to it). Forbidden for fixed, free, and ball joints. For cylindrical joints, this single axis defines both the rotation and translation direction.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="axis2" type="axis" minOccurs="0">
        <xs:annotation><xs:documentation>Secondary axis for universal joints (2-DOF). Defines the second rotation axis, which must be perpendicular to the primary axis. Only valid when type="universal"; forbidden on every other joint type.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="limit2" type="joint_limit" minOccurs="0">
        <xs:annotation><xs:documentation>Limits for the SECOND degree of freedom. Valid ONLY on universal, cylindrical, and planar joints; forbidden on every other type. Universal: bounds axis2 (radians; maps to SDF axis2/limit). Cylindrical: bounds the rotation DOF (radians), OPTIONAL (a cylindrical joint may leave rotation unbounded). Planar: bounds the second in-plane translation range (meters). The first-DOF limits are in &lt;limit&gt;.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="dynamics2" type="joint_dynamics" minOccurs="0">
        <xs:annotation><xs:documentation>Damping/friction/spring parameters for the SECOND degree of freedom (axis2). Maps to SDF axis2/dynamics for universal/revolute2 joints. Only valid when type="universal". Optional; the primary-axis dynamics are in &lt;dynamics&gt;.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="limit" type="joint_limit" minOccurs="0">
        <xs:annotation><xs:documentation>Position, velocity, effort, acceleration, and jerk limits for the FIRST degree of freedom. Required for revolute, prismatic, and cylindrical joints. Optional for continuous (velocity/effort ONLY; lower/upper are forbidden). Forbidden for fixed, free, and ball. Per-DOF meaning: for cylindrical, lower/upper are the translation range (meters) and the rotation range lives in &lt;limit2&gt; (radians, optional); for screw, lower/upper bound the ROTATIONAL DOF (radians) and the coupled axial translation is derived via thread_pitch; for universal, this is the primary-axis limit (radians) and axis2's is in &lt;limit2&gt;; for planar, this is the first in-plane translation range (meters) and the second is in &lt;limit2&gt;.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="swing_limit" type="swing_limit" minOccurs="0">
        <xs:annotation><xs:documentation>Swing-cone limit for a ball joint's two swing DOFs (half-angles in radians; circular or elliptic cone). Only valid on type="ball"; optional (omitted => unbounded swing). Paired with &lt;twist_limit&gt; for the twist DOF. Has no URDF/SDF home on export (URDF spherical and classic SDF ball carry no limits), recorded as a loss.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="twist_limit" type="joint_limit" minOccurs="0">
        <xs:annotation><xs:documentation>Twist limit for a ball joint's twist DOF (rotation about the twist axis, local X): lower/upper in radians. Only valid on type="ball"; optional (omitted => unbounded twist). Paired with &lt;swing_limit&gt; for the two swing DOFs. Reuses joint_limit (lower/upper radians; effort Nm; velocity rad/s). Has no URDF/SDF home on export, recorded as a loss.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="dynamics" type="joint_dynamics" minOccurs="0">
        <xs:annotation><xs:documentation>Damping, friction, and spring parameters for simulation.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="calibration" type="joint_calibration" minOccurs="0">
        <xs:annotation><xs:documentation>Calibration reference data for homing the joint to an absolute position.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="mimic" type="mimic" minOccurs="0">
        <xs:annotation><xs:documentation>Mimic constraint that makes this joint track another joint's position.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="loop" type="loop_closure" minOccurs="0">
        <xs:annotation><xs:documentation>Loop closure marker. Present when this joint closes a kinematic loop (parallel mechanism). The kinematic tree parser should treat this joint as a constraint, not a parent-child relationship. Used for four-bar linkages, delta robots, Stewart platforms.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="extension" type="extension" minOccurs="0">
        <xs:annotation><xs:documentation>Vendor/domain-specific extension data for this joint. Used (among other things) as the lax home for a joint-anchored URDF &lt;gazebo reference="joint"&gt; block on the byte-faithful import path. At most one per joint (xs:all); collect multiple domains as separate children inside it if needed.</xs:documentation></xs:annotation>
      </xs:element>
      <xs:element name="urdf-compat" type="urdf_compat_joint" minOccurs="0">
        <xs:annotation><xs:documentation>URDF-only, zero-CPS fields for this joint (e.g. safety_controller). Optional; present only when imported from URDF and needed for a lossless round-trip. Omit for native HCDF.</xs:documentation></xs:annotation>
      </xs:element>
    </xs:all>
    <xs:attribute name="name" type="xs:string" use="required">
      <xs:annotation><xs:documentation>Unique name for this joint (e.g., "left_shoulder_pitch", "wheel_fl_spin"). Required. Referenced by transmission elements and mimic constraints.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="type" type="JointType" use="required">
      <xs:annotation><xs:documentation>Joint type determining degrees of freedom and required sub-elements. Required.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="thread_pitch" type="xs:double">
      <xs:annotation><xs:documentation>Thread pitch for screw joints. Defines the linear advance per full rotation. Canonical HCDF storage is meters-per-revolution, RIGHT-handed (the modern gz screw_thread_pitch convention); legacy gazebo-classic thread_pitch (rad/m, left-handed) is converted to canonical on import (screw_thread_pitch = -2*pi / thread_pitch). The value here is interpreted per the OPTIONAL @pitch_convention and @handedness attributes, which default to m_per_rev and right (i.e. canonical); the SDF importer always converts to canonical and omits both attributes. Only valid when type="screw"; forbidden on every other joint type.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="pitch_convention" type="pitch_convention">
      <xs:annotation><xs:documentation>Unit convention of @thread_pitch: m_per_rev (canonical, default when absent) or rad_per_m (legacy gazebo-classic). Only valid on type="screw". Absent => m_per_rev.</xs:documentation></xs:annotation>
    </xs:attribute>
    <xs:attribute name="handedness" type="handedness">
      <xs:annotation><xs:documentation>Thread chirality of @thread_pitch: right (canonical, default when absent) or left (legacy gazebo-classic positive sense). Only valid on type="screw". Absent => right.</xs:documentation></xs:annotation>
    </xs:attribute>
  </xs:complexType>

